{{ 'component-purelane-bundles.css' | asset_url | stylesheet_tag }}

<section
  id="Bundles-{{ section.id }}"
  class="purelane-bundles color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="page-width">
    <div class="purelane-bundles__head">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-bundles__kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="purelane-bundles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- liquid
      assign bundle_entries = section.settings.bundles
    -%}

    {%- if bundle_entries != blank and bundle_entries.size > 0 -%}
      <div class="purelane-bundles__grid">
        {%- for bundle_entry in bundle_entries -%}
          {%- render 'card-purelane-bundle', bundle: bundle_entry -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="purelane-bundles__empty">
        Add Bundle tier entries in the theme editor to show pricing tiers here.
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Pick your plan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundles that fit your home"
    },
    {
      "type": "metaobject_list",
      "id": "bundles",
      "label": "Bundle tiers",
      "metaobject_type": "bundle_tier"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bundles"
    }
  ]
}
{% endschema %}
